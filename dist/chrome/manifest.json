{
  "manifest_version": 3,
  "name": "Fet Notification Filter",
  "version": "0.1.0",
  "description": "Filter your FetLife notifications by type: hide loves, comments, mentions, follows and more. Each type can be toggled individually.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://fetlife.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://fetlife.com/*"],
      "js": ["src/page.js"],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Notification Filter for FetLife",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
